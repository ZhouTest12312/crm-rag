# 复制为 .env 后填入真实值。不要提交 .env。
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
REDIS_URL=redis://127.0.0.1:6379/0
# 业务 MySQL（与 edu-crm-agent 可共用库名）
DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/edu_crm_agent?charset=utf8mb4
# 制度向量库（docker compose 里的 pgvector）
VECTOR_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/edu_crm_vectors
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# JWT 签名（生产务必换成长随机串）
JWT_SECRET_KEY=change-me-to-a-long-random-secret
